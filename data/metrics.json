{
  "feature": "NovaMind Search",
  "company": "PurpleMerit",
  "description": "AI-powered natural language search. Users type plain English queries instead of keywords.",
  "rollout_info": {
    "day_1_to_3": "Pre-launch baseline (old keyword search)",
    "day_4": "NovaMind launched to 50% of users",
    "day_6": "Hotfix deployed — partial accuracy improvement"
  },
  "metrics": {
    "search_accuracy_pct": {
      "description": "% of search queries returning correct results (sampled daily)",
      "unit": "%",
      "target": 95.0,
      "note": "Below 90% is considered a user-trust risk",
      "daily": [
        {"day": 1, "value": 95.2, "phase": "pre_launch"},
        {"day": 2, "value": 95.0, "phase": "pre_launch"},
        {"day": 3, "value": 95.3, "phase": "pre_launch"},
        {"day": 4, "value": 91.0, "phase": "launch"},
        {"day": 5, "value": 84.7, "phase": "launch"},
        {"day": 6, "value": 88.5, "phase": "post_hotfix"},
        {"day": 7, "value": 88.9, "phase": "post_hotfix"}
      ]
    },
    "daily_active_users": {
      "description": "Number of users actively using the product each day",
      "unit": "users",
      "target": 12000,
      "daily": [
        {"day": 1, "value": 11800, "phase": "pre_launch"},
        {"day": 2, "value": 12100, "phase": "pre_launch"},
        {"day": 3, "value": 11900, "phase": "pre_launch"},
        {"day": 4, "value": 13200, "phase": "launch"},
