        {"day": 6, "value": 35, "phase": "post_hotfix"},
        {"day": 7, "value": 31, "phase": "post_hotfix"}
      ]
    },
    "query_response_time_ms": {
      "description": "Average time for a search query to return results (milliseconds)",
      "unit": "ms",
      "target": 400,
      "note": "Spike on Day 5 caused by indexing pipeline overload",
      "daily": [
        {"day": 1, "value": 380, "phase": "pre_launch"},
        {"day": 2, "value": 390, "phase": "pre_launch"},
        {"day": 3, "value": 385, "phase": "pre_launch"},
