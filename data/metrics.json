        {"day": 6, "value": 13800, "phase": "post_hotfix"},
        {"day": 7, "value": 13500, "phase": "post_hotfix"}
      ]
    },
    "support_tickets_per_day": {
      "description": "Number of support tickets mentioning wrong or missing search results",
      "unit": "tickets",
      "target": 20,
      "note": "Baseline was ~18/day on old keyword search",
      "daily": [
        {"day": 1, "value": 18, "phase": "pre_launch"},
        {"day": 2, "value": 19, "phase": "pre_launch"},
        {"day": 3, "value": 17, "phase": "pre_launch"},
        {"day": 4, "value": 34, "phase": "launch"},
        {"day": 5, "value": 89, "phase": "launch"},
        {"day": 6, "value": 61, "phase": "post_hotfix"},
        {"day": 7, "value": 58, "phase": "post_hotfix"}
      ]
    },
    "nps_score": {
      "description": "Net Promoter Score — how likely users are to recommend PurpleMerit (-100 to +100)",
      "unit": "score",
      "target": 42,
      "note": "NPS lags 2-3 days behind the actual experience",
      "daily": [
        {"day": 1, "value": 42, "phase": "pre_launch"},
        {"day": 2, "value": 43, "phase": "pre_launch"},
        {"day": 3, "value": 42, "phase": "pre_launch"},
        {"day": 4, "value": 44, "phase": "launch"},
